{
  "entities": {
    "Agent": {
      "title": "Agent",
      "description": "Operational dispatch agent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "station": { "type": "string" },
        "team": { "type": "string" },
        "defaultMissionId": { "type": "string" },
        "order": { "type": "number" },
        "ownerId": { "type": "string" }
      },
      "required": ["id", "name", "station", "team", "order"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Predefined shift code and hours",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "hours": { "type": "string" },
        "defaultMissionId": { "type": "string" },
        "defaultPause": { "type": "string" },
        "order": { "type": "number" },
        "ownerId": { "type": "string" },
        "color": { "type": "string" },
        "season": { "type": "string" },
        "hidden": { "type": "boolean" }
      },
      "required": ["id", "code", "hours", "order"]
    },
    "PlanningDoc": {
      "title": "Planning Data",
      "description": "Grid schedule mapping agentId_YYYY-MM-DD to shiftCode",
      "type": "object",
      "properties": {
        "assignments": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "ApiToken": {
      "title": "API Token",
      "description": "Authentication token for REST API endpoints",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "token": { "type": "string" },
        "prefix": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastUsedAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "expiresAt": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "token", "prefix", "createdAt", "isActive"]
    },
    "User": {
      "title": "User Profile & Access",
      "description": "Registered users with role and approval status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "viewer"] },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected", "disabled"] },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "AccessSettings": {
      "title": "Access Control Settings",
      "description": "System-wide auto approval and security configurations",
      "type": "object",
      "properties": {
        "autoApprovalEnabled": { "type": "boolean" },
        "defaultRole": { "type": "string" },
        "allowedDomains": { "type": "array" },
        "adminEmails": { "type": "array" }
      }
    },
    "SwapRequest": {
      "title": "Shift Swap Request",
      "description": "Requests from agents to swap scheduled shifts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requesterUid": { "type": "string" },
        "requesterEmail": { "type": "string" },
        "requesterName": { "type": "string" },
        "requesterAgentId": { "type": "string" },
        "requesterAgentName": { "type": "string" },
        "targetAgentId": { "type": "string" },
        "targetAgentName": { "type": "string" },
        "dates": { "type": "array" },
        "requesterShifts": { "type": "object" },
        "targetShifts": { "type": "object" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "requesterUid", "requesterAgentId", "targetAgentId", "dates", "status"]
    }
  },
  "firestore": {
    "users": {
      "entity": "User",
      "description": "User profiles and RBAC permissions"
    },
    "settings": {
      "entity": "AccessSettings",
      "description": "Application settings and auto-approval rules"
    },
    "agents": {
      "entity": "Agent",
      "description": "List of agents"
    },
    "shifts": {
      "entity": "Shift",
      "description": "List of shift configurations"
    },
    "planning": {
      "entity": "PlanningDoc",
      "description": "Planning state persistence"
    },
    "swap_requests": {
      "entity": "SwapRequest",
      "description": "Shift swap requests and lifecycle states"
    },
    "api_tokens": {
      "entity": "ApiToken",
      "description": "Collection of authorized API tokens"
    }
  }
}
